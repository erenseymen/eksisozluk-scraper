#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_clean:
	rm -rf build/
	rm -rf dist/
	rm -rf *.egg-info/
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete 2>/dev/null || true

override_dh_auto_build:
	# Nothing to build - pure Python

override_dh_auto_install:
	# Install Python package using setup.py
	python3 setup.py install --root=debian/eksisozluk-scraper --prefix=/usr --install-layout=deb --no-compile
	
	# Install bash completion
	mkdir -p debian/eksisozluk-scraper/usr/share/bash-completion/completions
	cp debian/eksisozluk-scraper.bash-completion debian/eksisozluk-scraper/usr/share/bash-completion/completions/eksisozluk-scraper || true
	
	# Install fish completion
	mkdir -p debian/eksisozluk-scraper/usr/share/fish/vendor_completions.d
	cp completions/eksisozluk-scraper.fish debian/eksisozluk-scraper/usr/share/fish/vendor_completions.d/eksisozluk-scraper.fish || true
	
	# Compile Python bytecode
	dh_python3 || true

